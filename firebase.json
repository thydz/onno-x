{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "install.sh",
        "headers": [
          { "key": "Content-Type", "value": "text/x-shellscript; charset=utf-8" },
          { "key": "Cache-Control", "value": "no-cache, max-age=0" }
        ]
      }
    ],
    "cleanUrls": false
  }
}
